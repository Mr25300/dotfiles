Host github.com
    HostName github.com
    User git
    PreferredAuthentications publickey
    IdentityFile ~/.ssh/id_ed25519_github_auth
    IdentitiesOnly yes
    AddKeysToAgent 10m

# Host *
#     IdentityFile ~/.ssh/id_ed25519_github_sign
