Host sagittarius
    ProxyCommand sh -c "timeout 0.5 nc -z 10.0.0.2 22 2>/dev/null && nc 10.0.0.2 22 || nc 100.109.151.81 22"
    User sebastian
    IdentityFile ~/.ssh/id_ed25519_sagittarius
    IdentitiesOnly yes
    AddKeysToAgent 10m
