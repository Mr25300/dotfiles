[user]
    name = Sebastian Cooper-Giannotta
    email = 109829617+Mr25300@users.noreply.github.com
    signingkey = ~/.ssh/id_ed25519_github_sign.pub

[core]
    editor = nvim
    pager = nvim -R -
    autocrlf = input
    ; excludesfile = ~/.gitignore_global

[color]
    pager = no

[diff]
    tool = nvimdiff

[merge]
    tool = nvimdiff

[difftool "nvimdiff"]
    cmd = nvim -d \"$LOCAL\" \"$REMOTE\"

[mergetool "nvimdiff"]
    cmd = nvim -d \"$LOCAL\" \"$BASE\" \"$REMOTE\" -c \"wincmd w\" -c \"wincmd J\"
    trustExitCode = true

[init]
    defaultBranch = main

[gpg]
    format = ssh

[gpg "ssh"]
    allowedSignersFile = ~/.ssh/allowed_signers

[commit]
    gpgsign = true
